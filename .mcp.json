{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${HOME}/obscura/playwright-mcp.mjs"
      ]
    },
    "playwright-chrome": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${HOME}/obscura/playwright-mcp.mjs",
        "chrome"
      ]
    }
  }
}
