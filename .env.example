# .env.example — placeholder keys ONLY. Never put real secrets here.
# Copy to .env.local for local dev. Production values live in the Vercel dashboard.
# Full inventory lands in docs/ENV.md (Phase 0 Part 0.3).

# Supabase (public — safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — NEVER prefix with NEXT_PUBLIC_, never import client-side)
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (server-only — set when needed in Phase 1 Part 1.3; one or more)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Web search (server-only — Serper picked in Phase 1 Part 1.2, DEC-002)
# SERPER_API_KEY=
# (Brave/Tavily/Bing rejected — see DEC-002; adapter reports `skipped` without a key)

# Reddit (server-only — Phase 1 Part 1.1; app-only OAuth preferred, public-JSON fallback otherwise)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=pdf-lab/1.1 (read-only market research; contact via repo)
# REDDIT_AUTHOR_SALT=

# Search suggestions (LOCAL-ONLY, DEC-008 / Part 3.5): unofficial endpoints, never set on Vercel
# PDFLAB_UNOFFICIAL_AUTOCOMPLETE=1
# AUTOCOMPLETE_GEO=us
# Wikipedia pageviews (optional override; must name a contact URL)
# WIKIMEDIA_USER_AGENT=

# Scheduler (server-only — only if chosen in Phase 4 Part 4.2, DEC-001)
# CRON_SECRET=
